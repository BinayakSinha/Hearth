# Copy this file to ".env" and fill in your values. ".env" is git-ignored — never commit it.

# Amazon Bedrock (optional — without these, Hearth uses offline templates)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_BEARER_TOKEN_BEDROCK=paste-your-bedrock-api-key-here

# Optional: Bedrock Guardrails for anything Hearth reads to a child
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# Optional
# HEARTH_SECRET=any-long-random-string
# HEARTH_SAFETY_RESOURCE=Childline on 1098
