{
  "name": "hearth",
  "version": "0.1.0",
  "description": "Hearth — a family memory that talks back. An Alexa+ MCP server (Streamable HTTP) for family voice journaling, kids' speaking practice and cross-generational story threads.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings tsx watch src/server.ts",
    "start": "NODE_OPTIONS=--no-warnings tsx src/server.ts",
    "build": "tsc",
    "seed": "NODE_OPTIONS=--no-warnings tsx scripts/seed.ts",
    "test:e2e": "NODE_OPTIONS=--no-warnings tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1151.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
